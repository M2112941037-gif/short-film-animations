{
  "name": "master-of-death",
  "version": "0.1.0",
  "private": true,
  "description": "《死亡的主人》— code-drawn dark fairytale short film",
  "scripts": {
    "studio": "remotion studio",
    "fonts": "node scripts/fetch-fonts.mjs",
    "still": "remotion still src/index.ts --log=error",
    "preview": "REMOTION_RES=0.5 remotion render src/index.ts --concurrency=4 --codec=h264 --crf=20 --log=error",
    "render": "remotion render src/index.ts --concurrency=4 --codec=h264 --crf=18 --log=error",
    "typecheck": "tsc --noEmit -p .",
    "audio": "cd scripts && for n in 1 2 3; do ../.venv/bin/python score_part$n.py; done"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "5.9.3"
  }
}
